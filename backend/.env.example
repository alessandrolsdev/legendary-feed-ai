# Copie para .env e preencha. O arquivo .env não é versionado.

# Obrigatório. Gere em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Modelo do Gemini utilizado na análise.
GEMINI_MODEL=gemini-2.5-flash

# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula).
# Em produção, troque pelo domínio real do frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites de upload.
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=1536

# Tempo máximo de espera pela resposta do modelo, em segundos.
REQUEST_TIMEOUT_SECONDS=45

# Rate limiting por IP.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Servidor. Use 0.0.0.0 apenas quando quiser expor fora da máquina local.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
